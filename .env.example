# ==============================================================================
# VYOMA MEDIA - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# 
# Instructions:
# 1. For local development: copy this to .env.local
# 2. For Vercel production: add these keys in Vercel > Settings > Environment Variables
# 3. NEVER commit the actual .env.local file to GitHub
#
# ==============================================================================

# SITE CONFIGURATION
NEXT_PUBLIC_SITE_URL=https://vyomamedia.co.in

# --- TITAN MAIL CONFIGURATION (Nodemailer SMTP) ---
# Titan SMTP Server:
SMTP_HOST=smtp.titan.email
# Use port 465 (SSL) or port 587 (STARTTLS)
SMTP_PORT=465
SMTP_SECURE=true

# Your Titan Email Address (Full login username):
SMTP_USER=info@vyomamedia.co.in

# Your Titan Email Account Password:
SMTP_PASS=your_titan_email_password_here

# Where you want RFP and Contact submissions to be delivered:
CONTACT_EMAIL=info@vyomamedia.co.in
CAREERS_EMAIL=info@vyomamedia.co.in

# ANALYTICS (Optional)
NEXT_PUBLIC_ANALYTICS_ID=
