# SITE CONFIGURATION
NEXT_PUBLIC_SITE_URL=https://vyomamedia.co.in

# EMAIL CONFIGURATION (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
